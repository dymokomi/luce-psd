#prisma 4.0
def package "luce-psd" {
    str owner = "dymokomi"
    str version = "0.3.1"
    str kind = "package"
    str language = "luce-base"
    str description = "Photoshop file readers for Luce/Base: documents as layers (RGBA buffers with names, blend modes, opacity and clipping), brush files (.abr presets with their tips and patterns) and action descriptors."
    str readme = "README.md"
    str[] public = ["abr", "descriptor", "psd"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-std"
    }
}
