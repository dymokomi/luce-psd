#prisma 4.0
def package "luce-psd" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "A Photoshop document reader for Luce/Base: layers as RGBA buffers with their names, blend modes, opacity and clipping."
    str readme = "README.md"

    def export "psd" {
        str module = "luce_psd.psd"
    }
}
